# EcoCycle E-Waste Management Portal - Backend Configuration
PORT=5000
NODE_ENV=development

# SQL Server Configuration
DB_SERVER=localhost
DB_NAME=mywebsite
DB_USER=
DB_PASSWORD=
DB_PORT=1433
DB_TRUST_SERVER_CERTIFICATE=true

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173
