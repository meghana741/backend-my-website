# EcoCycle E-Waste Management Portal - Backend Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Database Configuration (SQL Server)
# If using Windows Authentication (recommended for local Windows dev), leave DB_USER and DB_PASSWORD blank.
DB_SERVER=localhost
DB_NAME=mywebsite
DB_USER=
DB_PASSWORD=
DB_PORT=1433
DB_TRUST_SERVER_CERTIFICATE=true

# Authentication (JWT)
JWT_SECRET=ecocycle_super_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (e.g. Vite React Frontend)
FRONTEND_URL=http://localhost:5173
